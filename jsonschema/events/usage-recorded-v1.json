{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://protocol.novagrid.invalid/jsonschema/events/usage-recorded-v1.json",
  "title": "NovaGrid Usage Recorded Event v1",
  "description": "最终成功用量事件，用于内部对账而不是第二次扣款命令；时间单位为毫秒。",
  "type": "object",
  "required": ["event_id", "event_type", "schema_version", "idempotency_key", "job_id", "brand_model", "prompt_tokens", "completion_tokens", "total_tokens", "gpu_milliseconds", "attempts", "successful_attempt", "occurred_at"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"const": "UsageRecorded"},
    "schema_version": {"const": "1.0"},
    "idempotency_key": {"type": "string", "pattern": "^usage:job_[A-Za-z0-9]+:final:v1$"},
    "job_id": {"type": "string", "pattern": "^job_[A-Za-z0-9]+$"},
    "brand_model": {"const": "novagrid-chat-7b-v1"},
    "prompt_tokens": {"type": "integer", "minimum": 0},
    "completion_tokens": {"type": "integer", "minimum": 0},
    "total_tokens": {"type": "integer", "minimum": 0},
    "gpu_milliseconds": {"type": "integer", "minimum": 0},
    "attempts": {"type": "integer", "minimum": 1, "maximum": 2},
    "successful_attempt": {"type": "integer", "minimum": 1, "maximum": 2},
    "occurred_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}
