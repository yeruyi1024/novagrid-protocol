{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://protocol.novagrid.invalid/jsonschema/update-manifest-v1.json",
  "title": "NovaGrid Update Manifest v1",
  "description": "Agent、Desktop 或 Runtime 更新清单。未知可选字段向前兼容，哈希和签名由消费者强制验证。",
  "type": "object",
  "required": ["schema_version", "component", "version", "platform", "architecture", "artifact", "published_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "component": {"enum": ["agent", "desktop", "runtime"]},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "minimum_compatible_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "platform": {"enum": ["windows", "ubuntu"]},
    "architecture": {"const": "amd64"},
    "artifact": {
      "type": "object",
      "required": ["url", "sha256", "size_bytes", "signature"],
      "properties": {
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "signature": {"type": "string", "minLength": 16, "maxLength": 4096}
      },
      "additionalProperties": true
    },
    "published_at": {"type": "string", "format": "date-time"},
    "required_after": {"type": ["string", "null"], "format": "date-time"}
  },
  "additionalProperties": true
}
